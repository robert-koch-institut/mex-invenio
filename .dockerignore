# Ignore local virtualenv (if present)
.venv/
logs/
.env
.env.tests

# VCS
.git/

# Local data/scratch, not part of the app
s3_downloads/
tmp/

# Editor/CI/tooling config, not needed at runtime
.idea/
.github/
.claude/

# Python/JS caches and test artifacts, rebuilt inside the image anyway
**/__pycache__/
**/*.egg-info/
**/node_modules/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
celerybeat-schedule*
