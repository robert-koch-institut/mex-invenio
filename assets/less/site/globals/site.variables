// Theme Colors
@rki-dark-blue: #03284C;
@rki-blue: #005eb7;
@rki-blue-80: #669ed4;
@rki-blue-60: #b3cfea;
@rki-blue-40: #ebf2f9;
@anthracite: #575756;
@anthracite-80: #999a9a;
@anthracite-60: #cccdcc;
@anthracite-40: #f1f2f1;
@green: #579931;
@green-80: #9ac283;
@green-60: #cde0c1;
@green-40: #eef5ea;
@yellow: #ebbd00;
@yellow-80: #f3d766;
@yellow-60: #f9ebb3;
@yellow-40: #fcf5d9;
@orange: #eb9117;
@orange-80: #f3bd74;
@orange-60: #f9deb9;
@orange-40: #fcf1e1;
@red: #be1622;
@red-80: #d8737a;
@red-60: #ecb9bd;
@red-40: #f9e8e9;
@purple: #7c518f;
@purple-80: #b097bc;
@purple-60: #d8cbdd;
@purple-40: #f5f1f6;
@white: #ffffff;
@black: #000000;


@primaryColor: @rki-dark-blue;
@secondaryColor: @rki-blue;
@highlightColor: @rki-blue-40;
@navbarBackgroundImage: none;

@successBackgroundColor: @green-60;
@errorBackgroundColor: @red-60;

@lightBackground: @rki-blue-40;
@highlightBackground: @highlightColor;
@whiteBackground: @white;
@mutedBackground: @anthracite-60;

@lightGrey: @anthracite-60;

@pageFont: "FiraSans", sans-serif;

@mutedTextColor: #404565;

@frontendHeaderBackgroundColor: @core-color-white-default;

@searchButtonColor: @core-color-white-default;
@searchButtonColorTextColor: @primaryColor;

@navbarBackgroundColor: transparent;
@navbarGradient: linear-gradient(90deg, #03284C 23%, rgba(224, 244, 252, 0.20) 79.46%);

@footerLightColor: @secondaryColor;
@footerDarkColor: @primaryColor;

@accessRightOpen: @green-80;
@accessRightRestricted: @red-80;
@accessRightEmbargoed: @orange-80;
@accessRightMetadataOnly: @purple-80;

@neutralLabelColor: @rki-blue-40;
@signupColor: @green-80;
@darkLinkColor: @primaryColor;
@lightLinkColor:@white;

@whiteTextColor: @white;
@blackTextColor: @black;

@font-face {
  font-family: 'FiraSans';
  src: url('../fonts/FiraSans-Regular.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
}

@fontFamily: "FiraSans";
@fontSize: 1rem;

@borderColor: @primaryColor;
@lightBorderColor: @rki-blue-60
